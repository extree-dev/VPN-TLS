# Скопируйте в .env и поменяйте под себя.

# Внешний порт HTTPS. 443 выглядит естественнее всего; если он занят — 8443.
PORT=443

# Имя в сертификате и SNI (клиент передаёт его в -sni).
DOMAIN=cdn.example.com

# Секретный путь туннеля. Придумайте свой, например: openssl rand -hex 8
VPN_PATH=/api/stream
