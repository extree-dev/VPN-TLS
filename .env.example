# Скопируйте в .env и поменяйте под себя.

# Внешний порт HTTPS. 443 выглядит естественнее всего; если он занят — 8443.
PORT=443

# Имя в сертификате и SNI (клиент передаёт его в -sni).
DOMAIN=cdn.example.com

# Секретный путь туннеля. Придумайте свой, например: openssl rand -hex 8
VPN_PATH=/api/stream

# DNS-серверы, которые получат клиенты.
DNS=1.1.1.1,1.0.0.1

# Адрес сервера в строках подключения (host:port). По умолчанию DOMAIN:PORT.
# Если DNS-записи для домена ещё нет — укажите IP, например 103.118.210.8:8443.
#PUBLIC_ADDR=

# --- Настоящий сертификат Let's Encrypt (домен в Cloudflare) ---
# 1. A-запись DOMAIN → IP сервера, режим «DNS only» (серое облако).
# 2. Cloudflare → My Profile → API Tokens → Create Token → «Edit zone DNS»,
#    зона — ваш домен. Токен — сюда.
# 3. Раскомментируйте три строки ниже и выполните: docker compose up -d --build
#CADDYFILE=Caddyfile.acme
#CF_API_TOKEN=
#PIN=off
